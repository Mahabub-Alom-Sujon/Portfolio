model service_page {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  heading_title       String?
  heading_title_color String?
  heading_title_des   String?
  createdAt           DateTime @default(now()) @db.Timestamp
  updatedAt           DateTime @default(now()) @updatedAt @db.Timestamp
}

model blog_page {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  heading_title       String?
  heading_title_color String?
  heading_title_des   String?
  createdAt           DateTime @default(now()) @db.Timestamp
  updatedAt           DateTime @default(now()) @updatedAt @db.Timestamp
}

model contact_page {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  heading_title           String?
  heading_title_color     String?
  heading_title_des       String?
  contact_form_heading    String?
  contact_info_google_map String?
  createdAt               DateTime @default(now()) @db.Timestamp
  updatedAt               DateTime @default(now()) @updatedAt @db.Timestamp
}

model message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  email     String?
  website   String?
  long_des  String?
  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp
}

model portfolio {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  title           String?
  category        String?
  img             String?
  github_link     String?
  live_link       String?
  technology_list technology_list[]
  createAt        DateTime          @default(now()) @db.Timestamp
  updateAt        DateTime          @default(now()) @updatedAt @db.Timestamp
}

model technology_list {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String?
  portfolioId String?    @db.ObjectId
  portfolio   portfolio? @relation(fields: [portfolioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createAt    DateTime   @default(now()) @db.Timestamp
  updateAt    DateTime   @default(now()) @updatedAt @db.Timestamp
}

model service {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String?
  sub_heading1 String?
  sub_heading2 String?
  sub_heading3 String?
  sub_heading4 String?
  img          String?
  createAt     DateTime @default(now()) @db.Timestamp
  updateAt     DateTime @default(now()) @updatedAt @db.Timestamp
}

model experience {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String?
  company      String?
  time_section String?
  long_des     String?
  createAt     DateTime @default(now()) @db.Timestamp
  updateAt     DateTime @default(now()) @updatedAt @db.Timestamp
}

model education {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String?
  time_section String?
  long_des     String?
  createAt     DateTime @default(now()) @db.Timestamp
  updateAt     DateTime @default(now()) @updatedAt @db.Timestamp
}

model testimonial {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title_name  String?
  sub_heading String?
  img         String?
  rating      String?
  long_des    String?
  createAt    DateTime @default(now()) @db.Timestamp
  updateAt    DateTime @default(now()) @updatedAt @db.Timestamp
}

model skill {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String?
  category     String?
  time_section String?
  subject      String?
  percent      String?
  createAt     DateTime @default(now()) @db.Timestamp
  updateAt     DateTime @default(now()) @updatedAt @db.Timestamp
}

